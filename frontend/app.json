{
  "expo": {
    "name": "Ghost Maze",
    "slug": "frontend",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0d1a",
          "image": "./assets/images/app-image.png",
          "imageWidth": 200
        }
      ]
    ],
    "android": {
      "package": "dev.charware.ghost_maze",
      "versionCode": 382,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5787827f-262b-4bfe-99fa-155b43855268"
      }
    },
    "owner": "chardcore"
  }
}
